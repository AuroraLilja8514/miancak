<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:fitsSystemWindows="true" android:focusableInTouchMode="true" android:focusedByDefault="true">
  <Button android:id="@+id/launcher_wanxiang_setup" style="@style/paragraph" android:text="@string/wanxiang_setup_title" android:layout_width="wrap_content"/>
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
      <TextView style="@style/paragraph" android:text="@string/wanxiang_setup_entry_summary"/>
      <TextView style="@style/paragraph" android:text="@string/launcher_description"/>
      <Button android:id="@+id/launcher_enable" style="@style/paragraph" android:text="@string/launcher_button_imesettings" android:onClick="launch_imesettings" android:layout_width="wrap_content"/>
      <Button android:id="@+id/launcher_select" style="@style/paragraph" android:text="@string/launcher_button_imepicker" android:onClick="launch_imepicker" android:layout_width="wrap_content"/>
      <TextView android:id="@+id/launcher_tryhere_text" style="@style/paragraph" android:text="@string/launcher_tryhere"/>
      <EditText android:id="@+id/launcher_tryhere_area" style="@style/paragraph" android:inputType="text" android:hint="@string/launcher_tryhere_hint" android:importantForAutofill="no"/>
      <LinearLayout style="@style/anim_box">
        <ImageView style="@style/anim" android:id="@+id/launcher_anim_swipe" android:background="@drawable/doc_key_u" android:src="@drawable/doc_anim_swipe"/>
        <TextView style="@style/anim_text" android:text="@string/launcher_anim_7"/>
      </LinearLayout>
      <LinearLayout style="@style/anim_box">
        <ImageView style="@style/anim" android:id="@+id/launcher_anim_circle" android:background="@drawable/doc_key_g" android:src="@drawable/doc_anim_circle"/>
        <TextView style="@style/anim_text" android:text="@string/launcher_anim_g"/>
      </LinearLayout>
      <LinearLayout style="@style/anim_box">
        <ImageView style="@style/anim" android:id="@+id/launcher_anim_round_trip" android:background="@drawable/doc_key_g" android:src="@drawable/doc_anim_round_trip"/>
        <TextView style="@style/anim_text" android:text="@string/launcher_anim_dash"/>
      </LinearLayout>
      <TextView style="@style/paragraph" android:text="@string/launcher_sourcecode"/>
      <TextView style="@style/paragraph" android:text="@string/launcher_project"/>
      <TextView android:id="@+id/launcher_repo_url" style="@style/paragraph" android:text="@string/launcher_repo_url" android:autoLink="web" android:linksClickable="true" android:textDirection="ltr"/>
      <TextView style="@style/paragraph" android:text="@string/launcher_feedback"/>
      <TextView android:id="@+id/launcher_issues_url" style="@style/paragraph" android:text="@string/launcher_issues_url" android:autoLink="web" android:linksClickable="true" android:textDirection="ltr"/>
    </LinearLayout>
  </ScrollView>
</LinearLayout>
