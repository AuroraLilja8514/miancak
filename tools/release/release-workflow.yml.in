# Generated by tools/release/generate_workflow.py; edit the reviewed helper sources.
name: MIANCAK Releases

on:
  workflow_run:
    workflows: [MIANCAK CI]
    types: [completed]
    branches: [master]
  workflow_dispatch:
    inputs:
      ci_run_id:
        description: 'Successful master push CI run to release (must still be current master)'
        required: true
        type: string

permissions:
  contents: read
  actions: read

concurrency:
  group: miancak-release
  cancel-in-progress: false

env:
  JAVA_TOOL_OPTIONS: ''
  _JAVA_OPTIONS: ''
  JDK_JAVA_OPTIONS: ''
  MIANCAK_CI_RUN_ID: ${{ github.event.workflow_run.id || inputs.ci_run_id }}

jobs:
  prepare:
    name: verify release source and prepare unsigned APK
    if: >-
      github.repository == 'AuroraLilja8514/miancak' &&
      github.ref == 'refs/heads/master' &&
      (github.event_name == 'workflow_dispatch' ||
       (github.event.workflow_run.conclusion == 'success' &&
        github.event.workflow_run.event == 'push' &&
        github.event.workflow_run.head_branch == 'master'))
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    outputs:
      ready: ${{ steps.prepare.outputs.ready }}
      source_sha: ${{ steps.guard.outputs.source_sha }}
      artifact_id: ${{ steps.upload.outputs.artifact-id }}
      artifact_digest: ${{ steps.upload.outputs.artifact-digest }}
    steps:
      - name: Independently verify master source and every CI gate before checkout
        id: guard
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          <<INLINE_OPS>>
          python "$RUNNER_TEMP/miancak-release-runtime/release_ops.py" guard --ci-run-id "$MIANCAK_CI_RUN_ID"
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          ref: ${{ steps.guard.outputs.source_sha }}
          persist-credentials: false
      - name: Inspect unsigned APK, source, version, previous Release and test fixtures
        id: prepare
        env:
          GH_TOKEN: ${{ github.token }}
        run: python tools/release/release_ops.py prepare --ci-run-id "$MIANCAK_CI_RUN_ID" --output prepared
      - name: Preserve the verified public signing input
        if: steps.prepare.outputs.ready == 'true'
        id: upload
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7
        with:
          name: miancak-release-input-${{ steps.guard.outputs.source_sha }}
          path: prepared/
          if-no-files-found: error
          retention-days: 7

  sign:
    name: sign the exact verified release APK
    needs: prepare
    if: needs.prepare.outputs.ready == 'true'
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    environment: release-signing
    permissions:
      contents: read
      actions: read
    outputs:
      artifact_id: ${{ steps.upload.outputs.artifact-id }}
      artifact_digest: ${{ steps.upload.outputs.artifact-digest }}
    steps:
      - name: Prepare fixed inline signing tools before injecting any credentials
        run: |
          <<INLINE_SIGN_RUNTIME>>
      - name: Recheck CI provenance and download only this run's prepared data
        env:
          GH_TOKEN: ${{ github.token }}
          PREPARED_ID: ${{ needs.prepare.outputs.artifact_id }}
          PREPARED_DIGEST: ${{ needs.prepare.outputs.artifact_digest }}
        run: |
          python "$RUNNER_TEMP/miancak-release-runtime/release_ops.py" fetch-prepared --artifact-id "$PREPARED_ID" --run-id "$GITHUB_RUN_ID" --digest "$PREPARED_DIGEST" --ci-run-id "$MIANCAK_CI_RUN_ID" --output "$RUNNER_TEMP/miancak-release-input"
      - name: Sign with the registered certificate, verify API 21 signatures and clean private staging
        env:
          MIANCAK_RELEASE_KEYSTORE_B64: ${{ secrets.MIANCAK_RELEASE_KEYSTORE_B64 }}
          MIANCAK_RELEASE_STORE_PASSWORD: ${{ secrets.MIANCAK_RELEASE_STORE_PASSWORD }}
        run: |
          ulimit -c 0
          python "$RUNNER_TEMP/miancak-release-runtime/sign_apk.py" "$RUNNER_TEMP/miancak-release-input" "$RUNNER_TEMP/miancak-release-output" "$RUNNER_TEMP/miancak-release-runtime"
      - name: Always remove private staging before any public upload
        if: always()
        run: |
          python - <<'PY'
          import os,shutil
          from pathlib import Path
          for path in Path(os.environ["RUNNER_TEMP"]).glob("miancak-signing-secret-*"):
              shutil.rmtree(path)
          PY
      - name: Upload only the three explicit public release files
        id: upload
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7
        with:
          name: miancak-signed-${{ needs.prepare.outputs.source_sha }}
          path: |
            ${{ runner.temp }}/miancak-release-output/miancak-*.apk
            ${{ runner.temp }}/miancak-release-output/release-provenance.json
            ${{ runner.temp }}/miancak-release-output/SHA256SUMS.txt
          if-no-files-found: error
          retention-days: 7

  acceptance:
    name: signed release acceptance (${{ matrix.api }})
    needs: [prepare, sign]
    runs-on: ubuntu-24.04
    timeout-minutes: 25
    strategy:
      fail-fast: false
      matrix:
        api: [23, 35]
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          ref: ${{ needs.prepare.outputs.source_sha }}
          persist-credentials: false
      - name: Retrieve the exact prepared fixtures and signed APK
        env:
          GH_TOKEN: ${{ github.token }}
          PREPARED_ID: ${{ needs.prepare.outputs.artifact_id }}
          PREPARED_DIGEST: ${{ needs.prepare.outputs.artifact_digest }}
          SIGNED_ID: ${{ needs.sign.outputs.artifact_id }}
          SIGNED_DIGEST: ${{ needs.sign.outputs.artifact_digest }}
        run: |
          python tools/release/release_ops.py fetch-prepared --artifact-id "$PREPARED_ID" --run-id "$GITHUB_RUN_ID" --digest "$PREPARED_DIGEST" --ci-run-id "$MIANCAK_CI_RUN_ID" --output prepared
          python tools/release/release_ops.py fetch --artifact-id "$SIGNED_ID" --run-id "$GITHUB_RUN_ID" --digest "$SIGNED_DIGEST" --output signed
      - name: Enable KVM
        run: |
          echo 'KERNEL=="kvm", GROUP="kvm", MODE="0666", OPTIONS+="static_node=kvm"' | sudo tee /etc/udev/rules.d/99-kvm4all.rules
          sudo udevadm control --reload-rules
          sudo udevadm trigger --name-match=kvm
      - name: Install and actually use the formally signed APK, preserve data and reboot
        uses: reactivecircus/android-emulator-runner@b530d96654c385303d652368551fb075bc2f0b6b # v2.35.0
        with:
          api-level: 35
          system-image-api-level: ${{ matrix.api }}
          emulator-build: ${{ matrix.api == 23 && '13823996' || '16428233' }}
          arch: x86_64
          target: google_apis
          avd-name: miancak-release-${{ matrix.api }}
          force-avd-creation: true
          disable-animations: true
          pre-emulator-launch-script: sed -i 's/^hw.keyboard=.*/hw.keyboard=no/' "$HOME/.android/avd/miancak-release-${{ matrix.api }}.avd/config.ini"
          emulator-options: -no-window -gpu swiftshader_indirect -feature -Vulkan -noaudio -no-boot-anim -no-snapshot -wipe-data -camera-back none
          script: python tools/release/device_smoke.py --api ${{ matrix.api }} --prepared prepared --signed signed --timeout-seconds 1200
      - name: Preserve only synthetic APK acceptance evidence
        if: always()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7
        with:
          name: signed-release-acceptance-${{ matrix.api }}-${{ needs.prepare.outputs.source_sha }}
          path: test-results/release/
          retention-days: 14

  publish:
    name: publish verified APK through GitHub Releases
    needs: [prepare, sign, acceptance]
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    permissions:
      contents: write
      actions: read
    steps:
      - name: Prepare the reviewed publication helper
        run: |
          <<INLINE_OPS>>
      - name: Verify the signed artifact and publish all Release assets
        env:
          GH_TOKEN: ${{ github.token }}
          SIGNED_ID: ${{ needs.sign.outputs.artifact_id }}
          SIGNED_DIGEST: ${{ needs.sign.outputs.artifact_digest }}
        run: |
          python "$RUNNER_TEMP/miancak-release-runtime/release_ops.py" fetch --artifact-id "$SIGNED_ID" --run-id "$GITHUB_RUN_ID" --digest "$SIGNED_DIGEST" --output signed
          python "$RUNNER_TEMP/miancak-release-runtime/release_ops.py" publish --output signed
